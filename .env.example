# ==============================================================================
# AL NAJM DIGITAL WALLET PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure with your deployment credentials.
# NEVER commit your production .env with secret keys into Git!
# ==============================================================================

# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.alnajm-wallet.com

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct Connection (For PHP Backend API)
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password

# SMS & OTP Gateway (e.g. Yemen Mobile, Sabafon, Twilio)
SMS_GATEWAY_URL=https://sms-api.telecom.ye/v1/send
SMS_API_KEY=your_sms_gateway_key
SMS_SENDER_NAME=ALNAJM

# Security & Limits
MAX_ACTIVE_DEVICES_PER_USER=3
MAX_HISTORICAL_DEVICES_PER_USER=10
JWT_EXPIRATION_HOURS=24
